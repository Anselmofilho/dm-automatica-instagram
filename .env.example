# Copie para .env e preencha. O .env nunca vai para o git (já está no .gitignore).

# --- Segurança e teste ---------------------------------------------------------------------

# true: o fluxo roda inteiro com as credenciais reais, mas NÃO manda DM. Avisa o que mandaria
# (no Discord, se configurado, ou no log). Comece sempre com true; troque para false só depois
# de ver o fluxo funcionando.
MODO_SIMULACAO=true

# true libera o painel do Mastra (npm run dev) e a API dele em /api/*. Só na sua máquina.
# No servidor, deixe sem: aí só o webhook responde e todo o resto dá 404.
# PAINEL_ABERTO=true

# --- Meta / Instagram ----------------------------------------------------------------------

# Um texto que você inventa (ex.: uma senha longa). Vai igual aqui e no campo "Verify token"
# do webhook no painel da Meta.
IG_VERIFY_TOKEN=

# App secret do seu app na Meta (painel do app > Instagram > Configuração da API com login do
# Instagram > "Chave secreta do app do Instagram"). Confere a assinatura de cada evento.
IG_APP_SECRET=

# Token de acesso de longa duração da conta do Instagram (gerado no mesmo painel). Vence em
# 60 dias: veja no README como renovar.
IG_TOKEN=

# ID da conta profissional do Instagram (o "ID do usuário do Instagram" no painel do app).
IG_BUSINESS_ACCOUNT_ID=

# --- Classificador -------------------------------------------------------------------------

# Chave da API do Groq (console.groq.com > API Keys).
GROQ_API_KEY=

# --- Banco ---------------------------------------------------------------------------------

# Postgres. No Supabase: Connect > Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha.
DATABASE_URL=

# --- Alertas (opcional) --------------------------------------------------------------------

# Webhook de um canal do Discord. Recebe o aviso quando o classificador falha e as mensagens do
# modo simulação. Sem ele, tudo vai só para o log.
DISCORD_ALERTA_WEBHOOK_URL=
