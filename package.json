    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "mastra": "1.30.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
