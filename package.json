  "description": "Agente de DM do Instagram que substitui o ManyChat: webhook da Meta, filtros, classificador com IA e resposta com link.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
